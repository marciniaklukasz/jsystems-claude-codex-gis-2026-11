<!doctype html>
<html lang="pl"><head><meta charset="utf-8"><title>Raport kontroli {{ run.run_id }}</title>
<style>body{font:15px system-ui,sans-serif;max-width:1200px;margin:2rem auto;padding:0 1rem;color:#20242a}table{border-collapse:collapse;width:100%;margin:1rem 0}th,td{border:1px solid #bbb;padding:.45rem;text-align:left;vertical-align:top}th{background:#eef1f4}pre{white-space:pre-wrap}img{object-fit:contain}</style></head><body>
<h1>Raport kontroli {{ run.created_at }}</h1><p>Run: {{ run.run_id }}; etap: {{ run.stage }}; CRS: {{ run.crs }}<br>Wersja pytań: {{ run.questions_version }}; hash commitu progów: {{ run.thresholds_commit }}</p>
<h2>Źródła</h2><table><thead><tr><th>nazwa</th><th>wersja</th><th>data</th><th>licencja</th></tr></thead><tbody>{% for s in run.sources or [] %}<tr><td>{{ s.name }}</td><td>{{ s.version }}</td><td>{{ s.date }}</td><td>{{ s.license }}</td></tr>{% endfor %}</tbody></table>
<h2>Liczności wejść</h2><ul>{% for name,count in input_counts.items() %}<li>{{ name }}: {{ thousands(count) }}</li>{% endfor %}</ul>
<h2>Połączenia zdjęć</h2><p>Pewne: {{ link_counts.certain or 0 }}; niepewne: {{ link_counts.uncertain or 0 }}; bez kandydata: {{ link_counts.no_candidate or 0 }}; razem: {{ link_counts.total or 0 }}. Zdjęcia bez kierunku: {{ link_counts.missing_heading or 0 }}.</p>
<h2>Podsumowanie</h2><table><thead><tr><th>atrybut</th><th>zgodne</th><th>rozbieżne</th><th>do sprawdzenia</th></tr></thead><tbody>{% for x in summary %}<tr><td>{{ x.label }}</td><td>{{ x.zgodne }}</td><td>{{ x['rozbieżne'] }}</td><td>{{ x['do sprawdzenia'] }}</td></tr>{% endfor %}</tbody></table>
<h2>Wykluczenia</h2><ul>{% for reason,count in exclusions.items() %}<li>{{ reason }}: {{ count }}</li>{% else %}<li>Brak wykluczeń.</li>{% endfor %}</ul><h2>Ograniczenia</h2><ul>{% for x in limitations %}<li>{{ x.source }}: {{ x.reason }}</li>{% else %}<li>Brak ograniczeń.</li>{% endfor %}</ul>
<h2>Modele</h2>{% if run.usage %}<table><tr><th>model</th><th>wysłane żądania</th><th>błędy</th><th>koszt USD</th></tr>{% for model,u in run.usage.items() %}<tr><td>{{ model }}</td><td>{{ u.sent }}</td><td>{{ u.errors }}</td><td>{{ "%.4f"|format(u.cost_usd) }}</td></tr>{% endfor %}</table><p>Łączny koszt: {{ "%.4f"|format(run.cost_total_usd) }} USD; liczba żądań: {{ run.requests_total }}</p><table><tr><th>pytanie</th><th>model decyzyjny</th><th>drugi stopień</th><th>kolejka ręczna</th><th>razem</th></tr>{% for q,x in run.vision_summary.items() %}<tr><td>{{ q }}</td><td>{{ x.decision }}</td><td>{{ x.fallback }}</td><td>{{ x.manual }}</td><td>{{ x.total }}</td></tr>{% endfor %}</table>{% else %}<p>Brak wywołań modelu w tej kontroli.</p>{% endif %}
<h2>Ewaluacja</h2>{% if run.evaluation %}{% for q,e in run.evaluation.items() %}<h3>{{ q }}</h3><p>Trafność i pokrycie; wykluczone etykiety niepewne: {{ e.uncertain_labels_excluded }}</p><table><tr><th>split</th><th>kto</th><th>pary</th><th>pewne</th><th>poprawne</th><th>pokrycie</th><th>Trafność</th></tr>{% for x in e.rows %}<tr><td>{{ x.split }}</td><td>{{ x.who }}</td><td>{{ x.pairs }}</td><td>{{ x.certain }}</td><td>{{ x.correct }}</td><td>{{ x.coverage }}</td><td>{{ x.accuracy if x.accuracy is not none else "brak danych" }}</td></tr>{% endfor %}</table>{% endfor %}{% else %}<p>Brak danych ewaluacji.</p>{% endif %}
<h2>Odczyty</h2>{% if readings|length %}<table><tr><th>photo_id</th><th>pytanie</th><th>odpowiedź</th><th>stopień</th><th>model</th><th>status</th><th>przyczyna</th></tr>{% for x in readings %}<tr><td>{{ x.photo_id }}</td><td>{{ x.question_id }}</td><td>{{ x.answer }}</td><td>{{ x.final_stage }}</td><td>{{ x.model }}</td><td>{{ x.status }}</td><td>{{ x.reason }}</td></tr>{% endfor %}</table>{% else %}<p>Brak odczytów.</p>{% endif %}
<h2>Kandydaci</h2>{% if empty %}<p>Brak kandydatów dla wybranego etapu.</p>{% else %}<table><thead><tr><th>kategoria</th><th>atrybut</th><th>candidate_id</th><th>OSM id</th><th>nazwa</th><th>overture_ids</th><th>osm_raw</th><th>overture_raw</th><th>daty</th><th>reasons</th><th>reason_text</th><th>połączenie</th><th>photo_reading</th><th>zdjęcia</th></tr></thead><tbody>{% for c in candidates %}<tr class="candidate"><td>{{ c.category }}</td><td>{{ c.attribute }}</td><td>{{ c.candidate_id }}</td><td><a href="{{ c.osm_url }}">{{ c.osm_id }}</a></td><td>{{ c.name }}</td><td>{{ c.overture_ids|tojson }}</td><td><pre>{{ c.osm_raw }}</pre></td><td><pre>{{ c.overture_raw }}</pre></td><td>{{ c.osm_timestamp }} / {{ c.overture_release }}</td><td>{{ c.reasons|tojson }}</td><td>{{ c.reason_text }}</td><td>{{ (c.link_details or [])|join("; ") }}</td><td>{{ c.photo_reading }}</td><td>{% for p in c.photos %}{% if p.path %}<img src="{{ p.path }}" width="160" alt="{{ p.id }}">{% else %}Zdjęcie niedostępne{% endif %}<br>{{ p.author or "" }}, {{ p.license or "" }} <a href="{{ p.source_url or "" }}">źródło</a><br>{% endfor %}</td></tr>{% endfor %}</tbody></table>{% endif %}
<footer>Dane OSM i Overture: ODbL 1.0; zdjęcia: CC BY-SA 4.0 (autorzy przy zdjęciach).</footer></body></html>
