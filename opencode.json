{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "uv run *": "allow",
      "uv --version": "allow",
      "python *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git checkout *": "deny",
      "git switch *": "deny",
      "git reset *": "deny",
      "git restore *": "deny",
      "git stash *": "deny",
      "git rebase *": "deny",
      "git merge *": "deny",
      "git clean *": "deny",
      "rm *": "deny",
      "del *": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv *": "deny",
      "set": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "Invoke-WebRequest *": "deny"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
